{
  "name": "infokes-pretest",
  "version": "0.0.1",
  "description": "File Manager Application",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "setup": "npm install",
    "dev": "npm run dev --workspaces",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "test:watch": "npm run test:watch --workspaces",
    "lint": "npm run lint --workspaces",
    "start:backend": "npm run --workspace=backend dev",
    "start:frontend": "npm run --workspace=frontend dev",
    "start": "npm run start:backend & npm run start:frontend",
    "clean": "rm -rf node_modules packages/*/node_modules packages/*/.next packages/*/dist",
    "docker:dev": "docker-compose -f docker-compose.dev.yml up -d",
    "docker:dev:logs": "docker-compose -f docker-compose.dev.yml logs -f",
    "docker:dev:stop": "docker-compose -f docker-compose.dev.yml down",
    "docker:prod": "docker-compose up -d",
    "docker:prod:logs": "docker-compose logs -f",
    "docker:prod:stop": "docker-compose down",
    "docker:build": "docker-compose build",
    "docker:build:dev": "docker-compose -f docker-compose.dev.yml build",
    "docker:clean": "docker-compose down -v && docker system prune -f"
  },
  "devDependencies": {}
}
